---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { sitio } from '../lib/sitio';

const enInicio = Astro.url.pathname === '/';
const base = enInicio ? '' : '/';
const anclas = [
  { href: `${base}#hub`, texto: 'Hub' },
  { href: `${base}#agenda`, texto: 'Agenda' },
  { href: `${base}#hitos`, texto: 'Hitos' },
  { href: `${base}#liderazgo`, texto: 'Liderazgo' },
  { href: `${base}#merch`, texto: 'Merch' },
];
const enEventos = Astro.url.pathname.startsWith('/events');
---

<header class="nav">
  <div class="wrap nav-in">
    <a href="/" class="marca" aria-label={`${sitio.nombre}, inicio`}>
      <Logo tam={2.6} />
      <span class="marca-txt">AWS UG <b>Santa Cruz de la Sierra</b></span>
    </a>

    <nav aria-label="Principal" class="nav-links">
      <ul>
        {anclas.map((a) => (
          <li>
            <a href={a.href}>{a.texto}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/events/" class="btn btn--verde nav-eventos" aria-current={enEventos ? 'page' : undefined}>
      Eventos
      <Icon name="arrow-right-line" />
    </a>

    <details class="menu">
      <summary aria-label="Abrir menú">
        <Icon name="menu-line" class="abrir" />
        <Icon name="close-line" class="cerrar" />
      </summary>
      <ul>
        {anclas.map((a) => (
          <li>
            <a href={a.href}>{a.texto}</a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #0c142e;
    border-bottom: 1px solid rgb(34 48 90 / 0.7);
  }

  .nav-in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.5rem;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    margin-right: auto;
  }

  .marca-txt {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--silver);
  }

  .marca-txt b {
    color: var(--ink);
    font-weight: 800;
  }

  .nav-links ul,
  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links ul {
    display: flex;
    gap: 0.25rem;
  }

  .nav-links a,
  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.8rem;
    border-radius: 999px;
    color: var(--silver);
    font-weight: 600;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 0.05);
  }

  .nav-eventos {
    min-height: 2.75rem;
    padding-block: 0.5rem;
  }

  .nav-eventos[aria-current='page'] {
    background: var(--green-hi);
    color: var(--lid-deep);
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    border: 2px solid var(--lid-line);
    cursor: pointer;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu :global(.icon) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .menu :global(.cerrar),
  .menu[open] :global(.abrir) {
    display: none;
  }

  .menu[open] :global(.cerrar) {
    display: block;
  }

  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    min-width: 12rem;
    padding: 0.5rem;
    background: var(--lid-raised);
    border: 1px solid var(--lid-line);
    border-radius: 1rem;
    box-shadow: 0 18px 30px -12px rgb(0 0 0 / 0.6);
  }

  .menu a {
    display: flex;
    font-size: 1.05rem;
  }

  @media (max-width: 960px) {
    .nav-links {
      display: none;
    }

    .menu {
      display: block;
    }

    .nav-in {
      gap: 0.6rem;
    }
  }

  @media (max-width: 420px) {
    .marca-txt {
      display: none;
    }
  }
</style>
