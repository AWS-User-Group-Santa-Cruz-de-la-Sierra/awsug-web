---
/** El lema del grupo: "La comunidad" fijo y su final rotando. */
---

<h1 class="lema">
  <span class="sr-only">
    La comunidad del entusiasmo, la comunidad de las risas, la comunidad de Santa Cruz de la Sierra
  </span>
  <span class="lema-fijo" aria-hidden="true">La comunidad</span>
  <span class="lema-rota" aria-hidden="true">
    <span class="frase">del <em class="c-violeta">entusiasmo</em></span>
    <span class="frase">de las <em class="c-verde">risas</em></span>
    <span class="frase">de <em class="scz">Santa Cruz de la&nbsp;Sierra</em></span>
  </span>
</h1>

<style>
  /* el tamaño sigue al ancho de la columna: "La comunidad" siempre cabe en una línea */
  .lema {
    font-size: clamp(2.1rem, 10cqi, 6rem);
    font-stretch: 118%;
    font-weight: 850;
    line-height: 0.94;
    letter-spacing: -0.03em;
  }

  .lema-fijo {
    display: block;
  }

  /* las tres frases ocupan la misma celda: la altura es la de la más larga */
  .lema-rota {
    display: grid;
  }

  .frase {
    grid-area: 1 / 1;
    opacity: 0;
    animation: frase 10.2s infinite both;
  }

  .frase:nth-child(2) {
    animation-delay: 3.4s;
  }

  .frase:nth-child(3) {
    animation-delay: 6.8s;
  }

  .frase em {
    font-style: normal;
  }

  .c-violeta {
    color: var(--violet-hi);
  }

  .c-verde {
    color: var(--green-hi);
  }

  /* Santa Cruz de la Sierra: verde, blanco y plata en movimiento */
  .scz {
    color: var(--green-hi);
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .scz {
      color: transparent;
      background-image: linear-gradient(
        100deg,
        var(--green-hi) 0%,
        #ffffff 18%,
        var(--silver) 32%,
        var(--green) 50%,
        #ffffff 68%,
        var(--silver) 82%,
        var(--green-hi) 100%
      );
      background-size: 240% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      animation: brillo 6s linear infinite;
    }
  }

  @keyframes frase {
    0% {
      opacity: 0;
      translate: 0 0.32em;
      filter: blur(10px);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    6% {
      opacity: 1;
      translate: 0 0;
      filter: blur(0);
    }
    30% {
      opacity: 1;
      translate: 0 0;
      filter: blur(0);
      animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
    }
    34.5% {
      opacity: 0;
      translate: 0 -0.22em;
      filter: blur(6px);
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes brillo {
    to {
      background-position: -240% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frase {
      animation-name: frase-suave;
    }

    .scz {
      animation: none;
    }
  }

  @keyframes frase-suave {
    0%,
    100% {
      opacity: 0;
    }
    6%,
    30% {
      opacity: 1;
    }
    34.5% {
      opacity: 0;
    }
  }
</style>
